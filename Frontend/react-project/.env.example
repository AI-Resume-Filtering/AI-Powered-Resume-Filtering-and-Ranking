# React Frontend Environment Variables
# API Base URL - Configure the backend deployment URL

# For local development (uses relative path for proxy)
VITE_API_BASE_URL=/api

# For deployed backends (e.g., Render, Heroku, AWS)
# Set this to your backend URL without /api suffix
# Example: https://your-backend-app.onrender.com
# The frontend will automatically append /api
VITE_BACKEND_URL=
