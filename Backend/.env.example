SECRET_KEY=dev-only-change-this-to-a-32-char-or-longer-random-secret

# MongoDB (Atlas SRV connection string)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGO_DB=resume_filtering
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=30000

# SMTP (optional in local dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Frontend and CORS
FRONTEND_BASE_URL=http://localhost:5173
# Set CORS_ALLOW_ALL=true to allow all origins (useful for production deployments)
# Set CORS_ALLOW_ALL=false to restrict to specific origins in CORS_ORIGINS (local development)
CORS_ALLOW_ALL=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000

# Branding and support
APP_NAME=Resume Filtering Platform
APP_LOGO_URL=
SUPPORT_EMAIL=

# Core scoring and limits
SCORE_THRESHOLD=70
FEEDBACK_RETRAIN_THRESHOLD=50
FEEDBACK_MIN_TRAIN_SAMPLES=20
MAX_CONTENT_LENGTH=20971520

# Password reset policy
PASSWORD_RESET_TOKEN_EXP_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS_PER_EMAIL_IP=5
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=20
PASSWORD_HISTORY_SIZE=5
MAX_FAILED_RESETS_BEFORE_LOCK=10
ACCOUNT_LOCK_DURATION_MINUTES=60

# External embeddings API (replaces local SBERT/sentence-transformers on Render)
# Eliminates ~200 MB of PyTorch memory — keeps the backend well under 512 MB.
# Set ONE of the API keys below. The provider is auto-detected from whichever key is present.
# If no key is set, scoring falls back to TF-IDF cosine similarity (no external calls).
# Optionally pin the provider with EMBEDDINGS_PROVIDER (openai | cohere | local).
# Leave EMBEDDINGS_PROVIDER blank for auto-detection (recommended).
#   openai  → OpenAI  text-embedding-3-small (1 536 dims) ~$0.02/1M tokens
#   cohere  → Cohere  embed-english-light-v3.0 (384 dims) free tier available
#   local   → local sentence-transformers model (development only, requires pip install)
EMBEDDINGS_PROVIDER=
OPENAI_API_KEY=
COHERE_API_KEY=

# Admin and optional integrations
ADMIN_API_KEY=
ADMIN_ALERT_EMAIL=
REDIS_URL=
RECAPTCHA_SECRET_KEY=
AUDIT_LOG_TTL_DAYS=90
RATE_LIMIT_TTL_DAYS=7
EMAIL_QUEUE_ENABLED=true
APP_DOMAIN=
AZURE_KEY_VAULT_URL=
